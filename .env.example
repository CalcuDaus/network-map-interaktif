# ==============================================================================
# SmartSchool NetMap — Konfigurasi Production Docker Compose (aaPanel)
# Salin file ini menjadi ".env" di folder /opt/docker-setting/network-map-interaktif
# lalu ganti password sebelum menjalankan: docker compose up -d --build
# ==============================================================================

# Zona Waktu Server
TZ=Asia/Jakarta

# Port Aplikasi Web (di-proxy oleh Nginx Website aaPanel -> http://127.0.0.1:3020)
APP_PORT=3020
# Ubah ke 127.0.0.1 jika sudah memakai domain + Reverse Proxy HTTPS di aaPanel
APP_BIND_IP=0.0.0.0

# Port MySQL ke Host (default hanya dapat diakses dari localhost VPS agar aman)
MYSQL_BIND_IP=127.0.0.1
MYSQL_EXTERNAL_PORT=3307

# Kredensial MySQL 8 (WAJIB GANTI di Production!)
MYSQL_DATABASE=netmap_db
MYSQL_USER=netmap
MYSQL_PASSWORD=Ganti_Password_NetMap_Kuat_2026
MYSQL_ROOT_PASSWORD=Ganti_Password_Root_MySQL_Kuat_2026
